{
  "name": "readium-js",
  "description": "A set of scripts for the EPUB navigator",
  "author": "Readium Foundation",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "private": true,
  "scripts": {
    "test": "vp test",
    "lint": "vp lint",
    "checkformat": "vp fmt --check",
    "format": "vp fmt",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tooling.json"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "0.2.5"
  },
  "dependencies": {
    "@juggle/resize-observer": "^3.4.0",
    "approx-string-match": "^1.1.0",
    "css-selector-generator": "^3.9.2",
    "string.prototype.matchall": "^4.0.12"
  },
  "packageManager": "pnpm@11.13.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.1",
      "onFail": "error"
    }
  }
}
