{
  "name": "readium-js",
  "description": "A set of scripts for the EPUB navigator",
  "author": "Readium Foundation",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "private": true,
  "scripts": {
    "bundle": "webpack",
    "test": "vp test",
    "lint": "vp lint",
    "checkformat": "vp fmt --check",
    "format": "vp fmt"
  },
  "browserslist": [
    "iOS 13"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "babel-loader": "^8.4.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "0.2.5",
    "webpack": "5.107.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@juggle/resize-observer": "^3.4.0",
    "approx-string-match": "^1.1.0",
    "css-selector-generator": "^3.9.2",
    "string.prototype.matchall": "^4.0.12"
  },
  "packageManager": "pnpm@11.13.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.1",
      "onFail": "error"
    }
