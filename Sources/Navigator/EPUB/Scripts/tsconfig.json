{
  "compilerOptions": {
    // JS stays importable from TS (untyped callers like
    // index-continuous-wrapper.js), but is not itself type-checked. Cadency
    // policy and state live in the strict TypeScript include below.
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    // Vite/Rolldown remain the sole authority on emitted module format and
    // Safari-15 syntax lowering; tsc here only type-checks, never emits.
    "module": "Preserve",
    "moduleResolution": "Bundler",
    // ES2020 optional-chaining/nullish-coalescing is the newest syntax any
    // owned source file uses today (verified by grep); ES2022 is picked as
    // headroom matching the Node >=24 devEngines floor, not because a
    // feature above ES2020 is in use yet.
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // Off, not the conventional default: this narrow `include` never pulls in
    // dependency .d.ts files, so there's no third-party noise to silence -
    // and skipLibCheck also covers our OWN src/types/*.d.ts. Verified by
    // probe: an invalid type reference inside webkit.d.ts (a typo'd handler
    // type) was silently accepted with skipLibCheck true and correctly
    // rejected (TS2304) once false, with zero new errors elsewhere.
    "skipLibCheck": false
  },
  "include": [
    "src/cadency/**/*.ts",
    "src/types/**/*.d.ts",
    "tests/cadency/**/*.ts"
  ],
  "exclude": ["node_modules", "src/vendor/**"]
}
