{
  "compilerOptions": {
    // JS stays importable from TS (untyped callers like
    // index-continuous-wrapper.js), but is not itself type-checked yet -
    // Plan 006 grows the checked surface one converted module at a time.
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    // Vite/Rolldown remain the sole authority on emitted module format and
    // Safari-15 syntax lowering; tsc here only type-checks, never emits.
    "module": "Preserve",
    "moduleResolution": "Bundler",
    // ES2020 optional-chaining/nullish-coalescing is the newest syntax any
    // owned source file uses today (verified by grep); ES2022 is picked as
    // headroom matching the Node >=24 devEngines floor, not because a
    // feature above ES2020 is in use yet.
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/cadency/**/*.ts",
    "src/types/**/*.d.ts",
    "tests/cadency/**/*.ts"
  ],
  "exclude": ["node_modules", "src/vendor/**"]
}
